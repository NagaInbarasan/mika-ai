# ==============================================================================
# MIKA - Git Ignore Configuration
# ==============================================================================

# Dependencies
node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Sensitive Files & Secrets (NEVER COMMIT)
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
credentials.json
auth.json
secrets.json
token.json

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
venv/
env/
ENV/
.venv/

# Large Datasets & Raw Telemetry
data/raw/*.jsonl
data/processed/*.jsonl
data/archive/
data/evolution/checkpoints/*.json
data/evolution/top-policies/rank-*.json
data/models/checkpoints/*.pt
data/test/
data/vision/screenshots/
data/vision/test/
!data/**/.gitkeep

# System & OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Configurations
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Runtime Logs
*.log
logs/
run/
