{
  "name": "mika-minecraft",
  "version": "0.1.0",
  "description": "MIKA Minecraft ALife Autonomous Simulation Bot powered by Qwen 3.5 9B",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "swarm": "node src/swarm/index.js",
    "train:swarm": "node src/swarm/train.js",
    "test:qwen": "node -e \"import('./src/planner/qwen.js').then(m => m.testQwenConnection())\"",
    "preprocess": "node src/data/preprocess.js",
    "pipeline": "node src/pipeline/index.js",
    "train": "py -3.10 src/train/train.py",
    "evaluate": "py -3.10 src/train/evaluate.py",
    "deploy": "py -3.10 src/train/deploy.py",
    "rollback": "node src/pipeline/index.js --rollback",
    "evolve": "node src/evolution/index.js",
    "evolve:top": "node src/evolution/select-top.js",
    "evolve:million": "node src/evolution/million-years.js",
    "evolve:benchmark": "node src/evolution/index.js --benchmark",
    "evolve:resume": "node src/evolution/index.js --resume data/evolution/checkpoints/latest.json",
    "test": "node --test tests/**/*.test.js",
    "test:vision": "node --test tests/vision.test.js",
    "test:vision:live": "node scripts/test-live-vision.js",
    "test:evolution": "node --test tests/world.test.js tests/policy.test.js tests/evolution.test.js tests/runner.test.js tests/evolution-cli.test.js tests/minecraft-adapter.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "mineflayer": "^4.20.1",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "ollama": "^0.5.14",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
